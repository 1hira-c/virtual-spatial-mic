{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual Spatial Mic",
  "version": "0.1.0",
  "identifier": "net.1hira.virtual-spatial-mic",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Virtual Spatial Mic", "width": 1120, "height": 800, "minWidth": 820, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": { "active": false, "icon": [] }
}
